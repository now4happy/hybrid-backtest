 STOCK_SELL_TAX = {2022: .0023, 2023: .0020, 2024: .0018, 2025: .0015, 2026: .0020}
 
+# ---- 호가 단위(틱) 가정 — working-copy 하네스 전용. 원본 초안(40a1b05)에는 없음.
+# TICK_MODE / TICK_TABLE_KIND는 드라이버가 모듈 속성으로 지정한다.
+# primary: 매수 체결가는 올림(사는 쪽이 다음 틱을 더 냄), 매도 체결가·매도 트리거는 내림(파는 쪽이 다음 틱을 덜 받음).
+# nearest: 양쪽 다 반올림. 매수 신호 문턱(눌림 가격)은 주문 가격이 아니라 신호 조건이라 반올림하지 않는다.
+# 바 가격(OHLC)은 시장 데이터라 건드리지 않는다. 계산된 주문·체결 가격만 반올림한다.
+TICK_MODE = "primary"
+TICK_TABLE_KIND = "etf"
+
+def tick_of(price):
+    if TICK_TABLE_KIND == "etf":
+        # ETF·ETN: 2000원 미만 1원, 2000원 이상 5원 (KRX, 2023-12~)
+        return 1 if price < 2000 else 5
+    if TICK_TABLE_KIND == "stock_old":
+        # 지시문에 적힌 표 = 개편 전 주식 표
+        if price < 1000: return 1
+        if price < 5000: return 5
+        if price < 10000: return 10
+        if price < 50000: return 10
+        if price < 100000: return 50
+        if price < 500000: return 100
+        return 500
+    # 현행 주식 표 (2023-01-25~)
+    if price < 2000: return 1
+    if price < 5000: return 5
+    if price < 20000: return 10
+    if price < 50000: return 50
+    if price < 200000: return 100
+    if price < 500000: return 500
+    return 1000
+
+def tick_round(price, side):
+    t = tick_of(price)
+    if TICK_MODE == "nearest":
+        return math.floor(price / t + 0.5) * t
+    if side == "buy":
+        return math.ceil(price / t - 1e-9) * t
+    return math.floor(price / t + 1e-9) * t
+
+
 
